      "id": "57b8871e-41f7-48f3-8c80-2809b80bb7f8",
      "name": "Classify Evaluation Case"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(item => item.json);\n\nconst classifications = [\n  'Resolved',\n  'Assisted',\n  'Customer Required'\n];\n\nconst passed = results.filter(\n  result => result.evaluation_pass === true\n);\n\nconst failed = results.filter(\n  result => result.evaluation_pass !== true\n);\n\nconst guardrailPassed = results.filter(\n  result => result.guardrail_status === 'passed'\n);\n\nconst guardrailNotPassed = results.filter(\n  result => result.guardrail_status !== 'passed'\n);\n\nconst byClassification = {};\n\nfor (const classification of classifications) {\n  const cases = results.filter(\n    result => result.expected_classification === classification\n  );\n\n  byClassification[classification] = {\n    total: cases.length,\n    passed: cases.filter(\n      result => result.evaluation_pass === true\n    ).length,\n    failed: cases.filter(\n      result => result.evaluation_pass !== true\n    ).length\n  };\n}\n\nreturn [\n  {\n    json: {\n      total_cases: results.length,\n      passed_cases: passed.length,\n      failed_cases: failed.length,\n      accuracy_percent:\n        results.length === 0\n          ? 0\n          : Number(((passed.length / results.length) * 100).toFixed(2)),\n      by_classification: byClassification,\n      failed_case_ids: failed.map(result => result.test_id),\n      guardrail_passed_cases: guardrailPassed.length,\n      guardrail_not_passed_cases: guardrailNotPassed.length,\n      guardrail_not_passed_case_ids:\n        guardrailNotPassed.map(result => result.test_id),\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
